<ui:UXML xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/UI/Styles/Toggle-style.uss?fileID=7433441132597879392&amp;guid=1b7dce002aa09bd4693fd4a640c9108d&amp;type=3#Toggle-style"/>
    <Style src="project://database/Assets/Content/UI/Styles/Buttons-style.uss?fileID=7433441132597879392&amp;guid=c27d3fe66dcee4046ad483deca7232d1&amp;type=3#Buttons-style"/>
    <Style src="project://database/Assets/Content/UI/Styles/Input-field-style.uss?fileID=7433441132597879392&amp;guid=f2b6487d66123cd438838f57d7848f59&amp;type=3#Input-field-style"/>
    <ui:VisualElement name="login-panel" style="flex-grow: 1; display: flex;">
        <ui:VisualElement name="tag" style="flex-grow: 1; min-height: 20px; max-height: 20px; margin-bottom: 15px; flex-direction: row; align-items: center; margin-top: 15px; display: flex;">
            <ui:VisualElement name="left-line" style="flex-grow: 1; background-color: rgb(87, 87, 87); min-height: 2px; max-height: 2px;"/>
            <ui:Label text="ВХОД" name="text" style="-unity-text-align: middle-center; margin-top: 0; margin-right: 5px; margin-bottom: 0; margin-left: 5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(87, 87, 87); font-size: 16px; -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/Content/Imports/Fonts/Russo_One/RussoOne-Regular.ttf?fileID=12800000&amp;guid=0ca6f19a298f9e94e8132f0ef8055d27&amp;type=3#RussoOne-Regular&quot;);"/>
            <ui:VisualElement name="right-line" style="flex-grow: 1; background-color: rgb(87, 87, 87); min-height: 2px; max-height: 2px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="content" style="flex-grow: 0; align-items: flex-start; align-self: auto; justify-content: center; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; color: rgb(255, 255, 255); min-width: auto; max-width: none; display: flex; flex-shrink: 0; min-height: auto; max-height: none; border-left-color: rgb(87, 87, 87); border-right-color: rgb(87, 87, 87); border-top-color: rgb(87, 87, 87); border-bottom-color: rgb(87, 87, 87); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; padding-top: 15px; padding-right: 15px; padding-bottom: 15px; padding-left: 15px; margin-bottom: 0;">
            <ui:Label text="// позывной" name="text" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 16px; color: rgb(232, 160, 32); left: auto; -unity-font-definition: url(&quot;project://database/Assets/Content/Imports/Fonts/Russo_One/RussoOne-Regular.ttf?fileID=12800000&amp;guid=0ca6f19a298f9e94e8132f0ef8055d27&amp;type=3#RussoOne-Regular&quot;); -unity-font-style: normal;"/>
            <ui:TextField placeholder-text="ВВЕДИТЕ ИМЯ" hide-placeholder-on-focus="true" name="username-text-field" focusable="true" class="input-field-style" style="margin-top: 0; margin-right: 0; margin-bottom: 20px; margin-left: 0; min-height: 50px; max-height: 50px; -unity-text-align: middle-center; white-space: nowrap; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; min-width: 100%; max-width: 100%; -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/Content/Imports/Fonts/Russo_One/RussoOne-Regular.ttf?fileID=12800000&amp;guid=0ca6f19a298f9e94e8132f0ef8055d27&amp;type=3#RussoOne-Regular&quot;); border-left-color: rgb(87, 87, 87); border-right-color: rgb(87, 87, 87); border-top-color: rgb(87, 87, 87); border-bottom-color: rgb(87, 87, 87);"/>
            <ui:VisualElement name="online-game-container" style="flex-grow: 1; min-width: 100%; max-width: 100%; min-height: 35px; max-height: 35px; justify-content: center; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(87, 87, 87); border-right-color: rgb(87, 87, 87); border-top-color: rgb(87, 87, 87); border-bottom-color: rgb(87, 87, 87); align-items: flex-start;">
                <ui:Toggle label="СЕТЕВАЯ ИГРА" name="online-game-toggle" focusable="false" style="-unity-font-definition: url(&quot;project://database/Assets/Content/Imports/Fonts/Russo_One/RussoOne-Regular.ttf?fileID=12800000&amp;guid=0ca6f19a298f9e94e8132f0ef8055d27&amp;type=3#RussoOne-Regular&quot;); font-size: 16px; display: flex; color: rgb(70, 70, 70); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; min-width: 175px; max-width: 175px; min-height: 30px; max-height: 30px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="address-container" style="flex-grow: 1; min-width: 100%; max-width: 100%; display: none;">
                <ui:Label text="// сервер" name="text" style="margin-top: 10px; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 16px; color: rgb(232, 160, 32); left: auto; -unity-font-definition: url(&quot;project://database/Assets/Content/Imports/Fonts/Russo_One/RussoOne-Regular.ttf?fileID=12800000&amp;guid=0ca6f19a298f9e94e8132f0ef8055d27&amp;type=3#RussoOne-Regular&quot;); -unity-font-style: normal;"/>
                <ui:TextField placeholder-text="ВВЕДИТЕ АДРЕСС" hide-placeholder-on-focus="true" name="address-text-field" focusable="true" class="input-field-style" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; min-height: 50px; max-height: 50px; -unity-text-align: middle-center; white-space: nowrap; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; min-width: 100%; max-width: 100%; -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/Content/Imports/Fonts/Russo_One/RussoOne-Regular.ttf?fileID=12800000&amp;guid=0ca6f19a298f9e94e8132f0ef8055d27&amp;type=3#RussoOne-Regular&quot;); display: flex;"/>
            </ui:VisualElement>
            <ui:Button text="Подтвердить" name="confirm-button" class="base-button-style default" style="min-width: 100%; max-width: 100%; margin-bottom: 0; margin-top: 20px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
