    <ui:VisualElement name="menu-root" style="overflow: hidden; align-items: center; flex-grow: 1; justify-content: center;">
        <ui:VisualElement name="background" style="background-image: url(&quot;project://database/Assets/Content/Imports/UI/Backrounds/start-menu-bg.png?fileID=2800000&amp;guid=a9d7eb4fb003d95409fe73fe9cd4c5a0&amp;type=3#start-menu-bg&quot;); position: absolute; min-width: 105%; max-width: 105%; max-height: 105%; min-height: 105%; bottom: -30px; -unity-background-scale-mode: scale-and-crop;"/>
        <ui:VisualElement name="dust" picking-mode="Ignore" enabled="false" style="position: absolute; min-width: 100%; max-width: 100%; max-height: 100%; min-height: 100%; background-image: url(&quot;project://database/Assets/Content/UI/RT-Dust.renderTexture?fileID=8400000&amp;guid=85b660831f18471468b8e483109569ff&amp;type=2#RT-Dust&quot;); -unity-background-image-tint-color: rgba(255, 255, 255, 0.75); display: flex;"/>
        <ui:VisualElement name="content-container" style="flex-grow: 1; min-width: 500px; display: flex; padding-top: 40px; padding-right: 40px; padding-bottom: 40px; padding-left: 40px; flex-shrink: 0; max-width: 500px; align-items: stretch; justify-content: center;">
            <ui:VisualElement name="menu-content" style="flex-grow: 0; display: flex;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
