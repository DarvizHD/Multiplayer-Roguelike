    <ui:VisualElement name="menu-root" style="overflow: hidden; align-items: center; flex-grow: 1; justify-content: center;">
        <ui:VisualElement name="background" style="background-image: url(&quot;project://database/Assets/Content/Imports/UI/menu-background.jpg?fileID=2800000&amp;guid=8ad501af5a494f749a947aff4d9686bc&amp;type=3#menu-background&quot;); position: absolute; min-width: 105%; max-width: 105%; max-height: 105%; min-height: 105%; bottom: -30px;"/>
        <ui:VisualElement name="content-container" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.85); min-width: 500px; display: flex; padding-top: 40px; padding-right: 40px; padding-bottom: 40px; padding-left: 40px; flex-shrink: 0; max-width: 500px; align-items: stretch; justify-content: center;">
            <ui:VisualElement name="menu-content" style="flex-grow: 0; display: flex;"/>
        </ui:VisualElement>
    </ui:VisualElement>
